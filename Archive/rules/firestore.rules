rules_version = '2';

// Anything without a match block is denied by default. Subcollections are NOT covered by their parent doc's rules, so posts/{postId}/likes and posts/{postId}/comments each need their own match block nested inside the posts one below.
// That applies at every depth, so a comment's own likes (posts/{postId}/comments/{commentId}/likes) need a match block nested one level deeper still, inside the comments one.

service cloud.firestore {
  match /databases/{database}/documents {
  
  	// Small helper function that will be reused everywhere.
  	function isSignedIn() {
    	return request.auth != null;
    }

    // This function checks a timestamp being written (createdAt, updatedAt, editedAt, lastRead): it has to be the server's own time for this request.
    // The services send serverTimestamp(), which Firestore fills in with request.time, so this is the only value that passes. The writer's device clock is never trusted.
    // Why it matters: lists are sorted by createdAt (the feed newest first, comments and messages oldest first, fits by board position). A client-chosen date could pin a post to the top of the feed,
    // or slip a comment or message in ahead of older ones. Every write in one batch shares the same request.time, which is what lets a message and its chat preview carry the same createdAt.
    // Update rules freeze createdAt (it has to equal the stored value), so it can't be swapped out later.
    function isNow(t) {
    	return t == request.time;
    }

    // This function checks a username: 3-16 characters of a-z, 0-9, and underscores (the same rule as getUsernameError in src/utils/validation.ts; change both together).
    // Used by the usernames claim and by the copies of a username stored on posts and comments, so neither can hold an oversized or malformed name.
    function isUsername(s) {
    	return s is string && s.matches('^[a-z0-9_]{3,16}$');
    }

    // This function checks that an image URL points at the app's own Storage bucket, inside the given folder for the given user (posts/{uid}/... or profile/{uid}/...).
    // Why it matters: post images and profile pictures load in every viewer's browser. Without this, a user could set either one to any URL on any site (a tracking pixel, for instance),
    // and every person who scrolled past their post would have their browser contact that site, leaking their IP address and when they looked. It also stops hotlinking off-site images into the feed.
    // The URL has to look exactly like what getDownloadURL() returns (see storage.service.ts):
    //   https://firebasestorage.googleapis.com/v0/b/<bucket>/o/posts%2F<uid>%2F<file>?alt=media&token=...
    // The path after /o/ is URL-encoded, which is why the slashes show up as %2F. Dots are written as [.] because a bare . in a regex matches any character.
    // <file> can't contain / ? or #, so a URL can't sneak out of the folder, and anything after the ? (alt, token, the ?t= cache buster) is allowed.
    // The bucket is the dev project's (fitlog-9ffc1, created back when the app was called FitLog; Firebase project IDs can't be renamed). When the production project is created, its bucket gets added here as a second option (planning/to-do.txt "Before launch"), or production uploads will be rejected.
    function isOwnStorageURL(url, folder, uid) {
    	return url is string
      	&& url.matches('^https://firebasestorage[.]googleapis[.]com/v0/b/fitlog-9ffc1[.]firebasestorage[.]app/o/' + folder + '%2F' + uid + '%2F[^/?#]+([?].*)?$');
    }

    // This function checks whether a field is part of an update. Used where a check only runs on the fields an update actually changes,
    // so older docs (written before a check existed) can still be edited without having to fix their untouched fields first.
    function isChanging(field) {
    	return request.resource.data.diff(resource.data).affectedKeys().hasAny([field]);
    }
    
    // User docs are the public profile: any signed-in user can read them (profile pages, follower lists, chat headers all need other people's docs).
    // That's only safe because the doc no longer stores email. Rules can't hide individual fields, so anything on this doc is visible to every signed-in user. Firebase Auth keeps the email instead.
    match /users/{userId} {
    	// This function handles field-level validation for the fields a user can set on their own profile, shared by create and the profile-edit update case.
      // bio and profilePicURL are optional (sign-up doesn't set them), so get() with a fallback is used, since reading a missing field directly would throw and deny the request.
    	function profileFieldsValid(d) {
      	return d.displayName is string
        	&& d.displayName.size() > 0
          && d.displayName.size() <= 30
          && d.get('bio', '') is string
          && d.get('bio', '').size() <= 150
          && d.get('profilePicURL', '') is string;
      }

      // This function checks the profile picture: empty (no picture, or one that was removed, which EditProfileForm saves as '') or an image in this user's own profile/ folder in Storage.
      function profilePicValid(d) {
      	return d.get('profilePicURL', '') == '' || isOwnStorageURL(d.profilePicURL, 'profile', userId);
      }

      // This function fetches the path of the caller's own doc in this user's followers subcollection. Same idea as myLikePath() in the posts block: the follower doc's id is the follower's uid, so there's exactly one fixed path to check.
      function myFollowerPath() {
      	return /databases/$(database)/documents/users/$(userId)/followers/$(request.auth.uid);
      }

      // Get: any signed-in user (profile pages, author lookups). List: only in small pages, which is all a "suggested users" query needs, so nobody can download every profile in one query.
      allow get: if isSignedIn();
      allow list: if isSignedIn() && request.query.limit <= 20;

      // Create: only for yourself, with a known field set, both counters starting at zero, and a username you actually own.
      // getAfter() reads the usernames doc as it will be AFTER this batch commits, which is what ties this doc to the username claim sign-up writes in the same batch, so nobody can create a profile under a username they never claimed.
      allow create: if isSignedIn()
      							&& request.auth.uid == userId
                    && request.resource.data.keys().hasOnly(['displayName', 'username', 'createdAt', 'bio', 'profilePicURL', 'followerCount', 'followingCount'])
                    && profileFieldsValid(request.resource.data)
                    && profilePicValid(request.resource.data)
                    && request.resource.data.username is string
                    && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username)).data.uid == request.auth.uid
                    && isNow(request.resource.data.createdAt)
                    && request.resource.data.followerCount == 0
                    && request.resource.data.followingCount == 0;

      // The three update cases below are additive, same as the post's update cases: an update goes through if ANY ONE passes, so each one pins down its own field set.
      // Update case #1: the owner editing their profile. Only displayName, bio and profilePicURL can move, so username (which has its own claim doc), createdAt and both counters stay frozen.
      // The picture is only checked when it changes, so a profile with an older picture URL can still edit its bio.
      allow update: if isSignedIn()
      							&& request.auth.uid == userId
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'bio', 'profilePicURL'])
                    && profileFieldsValid(request.resource.data)
                    && (!isChanging('profilePicURL') || profilePicValid(request.resource.data));

      // Update case #2: follower counter, moved by the person following/unfollowing (not the owner), same shape as the post like counter.
      // It moves by 1 and only when the same batched write also creates/deletes the caller's own doc in this user's followers subcollection, and nobody can follow themselves.
      allow update: if isSignedIn()
      							&& request.auth.uid != userId
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followerCount'])
                    && (
                    	(request.resource.data.followerCount == resource.data.followerCount + 1
                      	&& !exists(myFollowerPath())
                        && existsAfter(myFollowerPath()))
                      ||
                      (request.resource.data.followerCount == resource.data.followerCount - 1
                      	&& exists(myFollowerPath())
                        && !existsAfter(myFollowerPath()))
                    );

      // Update case #3: following counter, moved by the owner when they follow/unfollow someone.
      // Unlike case #2 this can't be bound to a follow doc: the rules only see this user doc's path, not WHO was just followed, so there's no fixed path to check (same caveat as the post's commentCount).
      // The worst a user can do is misreport their OWN following count, and never below zero. The other direction is closed: the following subcollection's create/delete rules below require this counter to move in the same batch, so a follow can't happen without it.
      allow update: if isSignedIn()
      							&& request.auth.uid == userId
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followingCount'])
                    && (request.resource.data.followingCount == resource.data.followingCount + 1
                    		|| request.resource.data.followingCount == resource.data.followingCount - 1)
                    && request.resource.data.followingCount >= 0;

      // Update case #4: the owner changing their username (authService.changeUsername). Only the username field can move, and only as part of the rename batch:
      // the NEW username's claim doc has to belong to the caller after the batch (getAfter), and the OLD one has to be gone (!existsAfter), so you can only switch to a name you actually claimed and you can't hold on to two names at once.
      allow update: if isSignedIn()
      							&& request.auth.uid == userId
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['username'])
                    && request.resource.data.username is string
                    && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username)).data.uid == request.auth.uid
                    && !existsAfter(/databases/$(database)/documents/usernames/$(resource.data.username));

      // Delete: owner only (authService.deleteUser), and only together with their username claim, so a deleted profile can't leave its name locked forever (claims can never be overwritten).
      // Like deleting a post, this orphans the followers/following subcollections underneath.
      allow delete: if isSignedIn()
      							&& request.auth.uid == userId
                    && !existsAfter(/databases/$(database)/documents/usernames/$(resource.data.username));

      // The two blocks below MUST stay nested inside this users block (same reason as likes/comments inside posts), which is also what puts userId in scope.
      // A follow is two mirrored docs plus two counters, all written in one batch by followService.toggleFollow:
      //   users/{target}/followers/{me}   +   target's followerCount   (bound by update case #2 above)
      //   users/{me}/following/{target}   +   my followingCount        (bound by the following block below)
      // Each follow doc requires its mirror to exist (or be gone) after the batch and its counter to move by exactly 1, so the four writes can only happen together and the halves can't drift.

      // One doc per follower, doc id = the follower's uid, so you can only add or remove YOURSELF as someone's follower, and only once.
      match /followers/{followerUid} {
      	function mirrorFollowingPath() {
        	return /databases/$(database)/documents/users/$(followerUid)/following/$(userId);
        }
        function followerCountMoved(delta) {
        	return getAfter(/databases/$(database)/documents/users/$(userId)).data.followerCount
          		== get(/databases/$(database)/documents/users/$(userId)).data.followerCount + delta;
        }

      	allow read: if isSignedIn();
        allow create: if isSignedIn()
        							&& request.auth.uid == followerUid
                      && followerUid != userId
                      && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
                      && request.resource.data.uid == followerUid
                      && isNow(request.resource.data.createdAt)
                      && existsAfter(mirrorFollowingPath())
                      && followerCountMoved(1);
        // Overwriting an existing follow doc counts as an update, so this is also what stops a double follow.
        allow update: if false;
        allow delete: if isSignedIn()
        							&& request.auth.uid == followerUid
                      && !existsAfter(mirrorFollowingPath())
                      && followerCountMoved(-1);
      }

      // One doc per followed user, doc id = their uid. Only the owner of this list can add to or remove from it.
      match /following/{followedUid} {
      	function mirrorFollowerPath() {
        	return /databases/$(database)/documents/users/$(followedUid)/followers/$(userId);
        }
        function followingCountMoved(delta) {
        	return getAfter(/databases/$(database)/documents/users/$(userId)).data.followingCount
          		== get(/databases/$(database)/documents/users/$(userId)).data.followingCount + delta;
        }

      	allow read: if isSignedIn();
        allow create: if isSignedIn()
        							&& request.auth.uid == userId
                      && followedUid != userId
                      && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
                      && request.resource.data.uid == followedUid
                      && isNow(request.resource.data.createdAt)
                      && existsAfter(mirrorFollowerPath())
                      && followingCountMoved(1);
        allow update: if false;
        allow delete: if isSignedIn()
        							&& request.auth.uid == userId
                      && !existsAfter(mirrorFollowerPath())
                      && followingCountMoved(-1);
      }

      // The two blocks below are the style board, and both are private: only the owner can read or write their own archive and fits (nobody else's style board is visible yet).
      // Since the check only needs userId from the path, the list queries the style board page runs (every doc in your own archive/fits) work without any extra reads.

      // The archive: pieces you've favorited from posts (source "favorite") or added yourself (source "own"). Each doc is a copy of the piece, see ArchivedPiece in src/types.ts.
      match /archive/{pieceId} {
      	// This function handles field-level validation for the piece itself, shared by both kinds. Every text field is capped at 100 characters (same caps as the add-piece form), and the detail fields are optional since a piece without details doesn't have them.
      	function pieceFieldsValid(d) {
        	return d.name is string
          	&& d.name.size() > 0
            && d.name.size() <= 100
            && d.get('price', '') is string && d.get('price', '').size() <= 100
            && d.get('size', '') is string && d.get('size', '').size() <= 100
            && d.get('materials', '') is string && d.get('materials', '').size() <= 100
            && d.get('dateAcquired', '') is string && d.get('dateAcquired', '').size() <= 100
            && d.hasDetails is bool
            && d.fromUsername is string;
        }

        // This function fetches the post a favorite says it came from. It only runs for favorites, so adding your own piece costs no extra read.
        function sourcePost() {
        	return get(/databases/$(database)/documents/posts/$(request.resource.data.postId));
        }

      	allow read: if isSignedIn() && request.auth.uid == userId;

        // Create: into your own archive only, as one of the two kinds.
        // Your own piece: it has to say it's from you, and can't claim to come from a post.
        // A favorite: the doc ID has to be postId_pieceIndex (which is what stops favoriting the same piece twice, since an existing doc can't be overwritten), and the copy has to match the real post: same owner, same name at that index, and same details setting.
        allow create: if isSignedIn()
        							&& request.auth.uid == userId
                      && pieceFieldsValid(request.resource.data)
                      && isNow(request.resource.data.createdAt)
                      && (
                      	(request.resource.data.source == 'own'
                        	&& request.resource.data.keys().hasOnly(['name', 'price', 'size', 'materials', 'dateAcquired', 'hasDetails', 'source', 'fromUid', 'fromUsername', 'createdAt'])
                          && request.resource.data.fromUid == userId)
                        ||
                        (request.resource.data.source == 'favorite'
                        	&& request.resource.data.keys().hasOnly(['name', 'price', 'size', 'materials', 'dateAcquired', 'hasDetails', 'source', 'fromUid', 'fromUsername', 'createdAt', 'postId', 'pieceIndex'])
                          && request.resource.data.postId is string
                          && request.resource.data.pieceIndex is int
                          && pieceId == request.resource.data.postId + '_' + string(request.resource.data.pieceIndex)
                          && request.resource.data.fromUid == sourcePost().data.uid
                          && request.resource.data.hasDetails == sourcePost().data.hasDetails
                          && request.resource.data.name == sourcePost().data.pieces[request.resource.data.pieceIndex].name)
                      );

        // Archived pieces can't be edited for now, only removed (and favorited/added again).
        allow update: if false;
        allow delete: if isSignedIn() && request.auth.uid == userId;
      }

      // Planned fits: an optional name plus five sections of pieces copied from the archive, see Fit in src/types.ts.
      match /fits/{fitId} {
      	// This function checks one section of a fit: a list of up to 10 pieces. get() with a fallback lets a section be missing entirely.
        // (Rules can't loop over a list, so the pieces inside aren't checked one by one. The 10 piece cap per section is what keeps a fit doc small.)
      	function sectionValid(sections, key) {
        	return sections.get(key, []) is list && sections.get(key, []).size() <= 10;
        }

        // This function handles field-level validation shared by create and update: the name is optional and capped at 40 characters, and sections can only hold the five known parts of an outfit.
        function fitFieldsValid(d) {
        	return (!('name' in d) || (d.name is string && d.name.size() > 0 && d.name.size() <= 40))
          	&& d.sections is map
            && d.sections.keys().hasOnly(['headwear', 'tops', 'bottoms', 'footwear', 'accessories'])
            && sectionValid(d.sections, 'headwear')
            && sectionValid(d.sections, 'tops')
            && sectionValid(d.sections, 'bottoms')
            && sectionValid(d.sections, 'footwear')
            && sectionValid(d.sections, 'accessories');
        }

      	allow read: if isSignedIn() && request.auth.uid == userId;
        allow create: if isSignedIn()
        							&& request.auth.uid == userId
                      && request.resource.data.keys().hasOnly(['name', 'sections', 'createdAt'])
                      && fitFieldsValid(request.resource.data)
                      && isNow(request.resource.data.createdAt);

        // Update: the owner editing a fit. createdAt is frozen (it's what decides the fit's spot on the board), and updatedAt has to be set to the server's time.
        allow update: if isSignedIn()
        							&& request.auth.uid == userId
                      && request.resource.data.keys().hasOnly(['name', 'sections', 'createdAt', 'updatedAt'])
                      && fitFieldsValid(request.resource.data)
                      && request.resource.data.createdAt == resource.data.createdAt
                      && isNow(request.resource.data.updatedAt);
        allow delete: if isSignedIn() && request.auth.uid == userId;
      }
    }
    
  	// Username get stays public since the sign-up form checks for username availabilty before the user is authenticated, unauthenticated reads only possible if public.
    // Listing is off for everyone, so nobody can download every username with its owner's UID; the app only ever looks up one name at a time.
    // Username creation is only possible for yourself (uid must match), doc id must equal the stored username (request.resource.data.username), and no extra fields are published when the doc is created.
    // The claim also has to be the name your profile uses after the batch (getAfter on your user doc). Sign-up and renames write both together, so this is what stops one account from claiming extra names.
    // The name itself has to be 3-16 characters of a-z, 0-9, and underscores (the same rule as getUsernameError in src/utils/validation.ts, which used to be the only place it was checked; change both together).
    // The pattern only allows lowercase letters, so it also covers the old "must be lowercase" check. The app lowercases names before saving, which is why the sign-up form can still accept capitals.
    // This is the only rule that needs the check: creating a user doc (sign-up) and renaming (users update case #4) both require a claim doc for the name, so a bad name can't get onto a profile any other way.
    // Username update is hardcoded false to ensure that when a user wants to update their name, the old username doc is deleted and replaced with a doc for the new username.
    // Username deletion is only possible when the user is authenticated and the existing document's uid field matches the caller's uid (whoever is trying to delete their username).
    // On top of that, a claim can only be given up while it's no longer in use: either the owner's user doc is being deleted in the same batch (account deletion) or it's being switched to a different username (a rename).
    // Without this, a user could delete their claim while their profile still shows that username, and someone else could then claim the same name.
    match /usernames/{username} {
    	function ownerUserPath() {
      	return /databases/$(database)/documents/users/$(resource.data.uid);
      }

    	allow get: if true;
      allow create: if isSignedIn()
      							&& request.resource.data.keys().hasOnly(['uid', 'username', 'createdAt'])
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.username == username
                    && isUsername(username)
                    && isNow(request.resource.data.createdAt)
                    && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.username == username;
      allow update: if false;
      allow delete: if isSignedIn()
      							&& request.auth.uid == resource.data.uid
                    && (!existsAfter(ownerUserPath()) || getAfter(ownerUserPath()).data.username != username);
    }

    // Posts (and their likes and comments) can only be read by signed-in users. Every page that shows them is behind the login, so public reads would only serve scrapers.
    // Post creation is only possible for yourself (uid must match), the data that's inputted fulfills the post fields validation, and if the like/comment counts are initialized to 0.
    match /posts/{postId} {
    	// This function handles field-level validation which shared by create and owner-update.
    	// It rejects extra/or unknown fields, wrong types, oversized captions, and too many pieces to be consistent with client code.
    	function postFieldsValid(d) {
      	return d.keys().hasOnly(['id', 'uid', 'username', 'caption', 'pieces', 'hasDetails', 'createdAt', 'updatedAt', 'imageURL', 'likeCount', 'commentCount'])
        	&& d.id == postId
          && d.uid is string
          && isUsername(d.username)
          && d.caption is string && d.caption.size() <= 500
          && d.pieces is list && d.pieces.size() <= 8
          && d.hasDetails is bool
          && d.imageURL is string
          && d.likeCount is int
          && d.commentCount is int;
      }
      
      // This function checks one piece of a post: a map with only the five piece fields (see PieceDetail in src/types.ts), all strings.
      // The name is required (1-100 characters), and each detail is optional and capped at 100. These are the same caps as an archived piece, so any piece on a post can be favorited.
      // PostDescription always sends all five fields (empty strings for details that weren't filled in), which is why '' has to pass for the details.
      // Each field is checked with one regex instead of separate "is string" and size() checks, because rules can only evaluate so many expressions per request, and with 8 pieces
      // the longer version ran out (posts with 7 or 8 pieces were denied). matches() on a non-string is an error, which denies the write, so the regex is the type check too.
      // Same idea for the map check: keys() on anything that isn't a map is an error, so a piece that's a plain string (or a number) is denied.
      // (?s) lets . match line breaks as well, so a pasted value with a newline is still counted by length instead of being rejected outright.
      function pieceValid(p) {
      	return p.keys().hasOnly(['name', 'price', 'size', 'materials', 'dateAcquired'])
        	&& p.name.matches('(?s)^.{1,100}$')
          && pieceDetailsValid(p);
      }

      // This function checks a piece's four optional details, shared by pieceValid and the piece a comment can be about (commentPieceValid below).
      function pieceDetailsValid(p) {
      	return p.get('price', '').matches('(?s)^.{0,100}$')
          && p.get('size', '').matches('(?s)^.{0,100}$')
          && p.get('materials', '').matches('(?s)^.{0,100}$')
          && p.get('dateAcquired', '').matches('(?s)^.{0,100}$');
      }

      // This function checks every piece on a post. Rules have no loops, so each of the 8 possible positions is checked by hand; a position past the end of the list is skipped (the size check is false, so || never reads it).
      // postFieldsValid already caps the list at 8, so these 8 lines cover every piece.
      function piecesValid(pieces) {
      	return (pieces.size() < 1 || pieceValid(pieces[0]))
        	&& (pieces.size() < 2 || pieceValid(pieces[1]))
          && (pieces.size() < 3 || pieceValid(pieces[2]))
          && (pieces.size() < 4 || pieceValid(pieces[3]))
          && (pieces.size() < 5 || pieceValid(pieces[4]))
          && (pieces.size() < 6 || pieceValid(pieces[5]))
          && (pieces.size() < 7 || pieceValid(pieces[6]))
          && (pieces.size() < 8 || pieceValid(pieces[7]));
      }

      // This function fetches the path of the caller's own like doc for this post (since likes are subcollections).
      function myLikePath() {
      	return /databases/$(database)/documents/posts/$(postId)/likes/$(request.auth.uid);
      }

      // This function fetches the path of this post, used by the likes and comments blocks below to check that the post's counters move with them.
      function postPath() {
      	return /databases/$(database)/documents/posts/$(postId);
      }

      allow read: if isSignedIn();
      
      // Create: you can only create a post as yourself (uid is validated against your auth token, closing the impersonation hole AKA unauthorized users logging into other users accounts) with valid inputs and both counters (like/comment) starting at zero.
      allow create: if isSignedIn()
      							&& request.resource.data.uid == request.auth.uid
                    && postFieldsValid(request.resource.data)
                    && piecesValid(request.resource.data.pieces)
                    && isOwnStorageURL(request.resource.data.imageURL, 'posts', request.auth.uid)
                    && isNow(request.resource.data.createdAt)
                    && !('updatedAt' in request.resource.data)
                    && request.resource.data.likeCount == 0
                    && request.resource.data.commentCount == 0;
                    
      // The three update cases below are additive, meaning an update goes through if ANY ONE of them passes. That's why each one locks down the exact set of fields it allows to change (via diff/affectedKeys or by re-asserting the frozen values), otherwise the loosest rule would quietly cancel out the stricter ones.
      // Update case #1: post creator editing their own post's content. uid/username/createdAt are frozen (no reassigning posts, no backdating, no posing as someone else) and the counters cannot be tampered with in this case.
      // Pieces and the image are only checked when they change, so an older post can still have its caption edited. updatedAt, when it changes, has to be the server's time.
      allow update: if isSignedIn()
      							&& request.auth.uid == resource.data.uid
                    && postFieldsValid(request.resource.data)
                    && (!isChanging('pieces') || piecesValid(request.resource.data.pieces))
                    && (!isChanging('imageURL') || isOwnStorageURL(request.resource.data.imageURL, 'posts', request.auth.uid))
                    && (!isChanging('updatedAt') || isNow(request.resource.data.updatedAt))
                    && request.resource.data.uid == resource.data.uid
                    && request.resource.data.username == resource.data.username
                    && request.resource.data.createdAt == resource.data.createdAt
                    && request.resource.data.likeCount == resource.data.likeCount
                    && request.resource.data.commentCount == resource.data.commentCount;
      
      // Update case #2: like counter, which can be manipulated by any signed-in user but ONLY in increments or decrements of 1 to the total likes on the post and ONLY when the same batched write also creates/deletes that user's own like doc (checked via exists/existsAfter) according to whether they liked/unliked the post.
      // In simpler words, the counter physically cannot change without a matching like doc and each user can move the counter at most ONCE in each direction.
      // The likes block below closes the other direction (a like doc can't be created or deleted without this counter moving), so the count always equals the number of like docs.
      allow update: if isSignedIn()
      							&& request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount'])
                    && (
                    	(request.resource.data.likeCount == resource.data.likeCount + 1 
                      	&& !exists(myLikePath())
                        && existsAfter(myLikePath()))
                      ||
                      (request.resource.data.likeCount == resource.data.likeCount - 1
                      	&& exists(myLikePath())
                        && !existsAfter(myLikePath()))
                    );
      
      // Update case #3: comment counter, same behavior as with like counter above, count can never be negative. However, unlike likes, this can't be bound to the specific comment doc (id is client-generated, so no fixed path to check; which is what the myLikePath() function above does).
      // The comments block below closes the other direction (a comment can't be added or deleted without this counter moving). What's left is that a determined user could nudge the count without commenting,
      // which only a Cloud Function trigger maintaining the counter server-side would fully close.
      allow update: if isSignedIn()
      							&& request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentCount'])
                    && (request.resource.data.commentCount == resource.data.commentCount + 1
                    		|| request.resource.data.commentCount == resource.data.commentCount - 1)
                  	&& request.resource.data.commentCount >= 0;
                    
    	// Delete: owner of post can only delete the post.
      // Deleting a post does NOT delete its likes/comments subcollections (a client can't delete a whole subcollection), so those docs are orphaned until the cleanup Cloud Function on the to-do list exists.
      allow delete: if isSignedIn() && request.auth.uid == resource.data.uid;

      // The two blocks below MUST stay nested inside this posts block, since the real paths are posts/{postId}/likes/{uid} and posts/{postId}/comments/{commentId}. Sitting outside, they'd match top-level /likes and /comments collections that don't exist, and every subcollection read/write would be denied.
      // Being nested is also what puts postId in scope for the comments delete rule below.

      // One doc associated per liker, doc id = their uid (having doc id double as the uid is what enforces the "one like per user" rule and "only toggle your OWN like" server-side).
      match /likes/{userId} {
      	// This function checks that the post's likeCount moves by delta in the same batch (getAfter vs get), the same pairing the followers block uses for followerCount.
      	// Without it, "like in a batch, then delete just the like doc" would add 1 every time, and the reverse would take the count below zero.
      	function likeCountMoved(delta) {
        	return getAfter(postPath()).data.likeCount == get(postPath()).data.likeCount + delta;
        }

      	// This is needed so the app can check "did I like this?" across each user.
      	allow read: if isSignedIn();
        allow create: if isSignedIn()
        							&& request.auth.uid == userId
                      && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
                      && request.resource.data.uid == userId
                      && isNow(request.resource.data.createdAt)
                      && likeCountMoved(1);
        allow update: if false;
        // Once the post is deleted there's no counter left to move, so its leftover like docs stay until the post cleanup Cloud Function on the to-do list exists.
        allow delete: if isSignedIn()
        							&& request.auth.uid == userId
                      && likeCountMoved(-1);
      }

      // One doc associated per comment, comments are created AS yourself (uid validated), can only be edited by their author, and can be deleted either by their author or by the post's owner (moderation).
      match /comments/{commentId} {
      	// Same idea as myLikePath() above, just one level deeper, since a comment's likes live at posts/{postId}/comments/{commentId}/likes/{uid}.
        // Both postId and commentId are in scope here only because this block is nested inside the posts block.
      	function myCommentLikePath() {
        	return /databases/$(database)/documents/posts/$(postId)/comments/$(commentId)/likes/$(request.auth.uid);
        }

        // This function checks that the post's commentCount moves by delta in the same batch, which also proves the post exists (get() on a missing doc denies the request).
        function commentCountMoved(delta) {
        	return getAfter(postPath()).data.commentCount == get(postPath()).data.commentCount + delta;
        }

        // This function handles validation for the optional piece a comment can be about (see CommentPiece in src/types.ts). It's a copy of one of the post's pieces, so the name and details setting have to match the post's piece at that index.
        // The details get the same 0-100 character check as a post's pieces, so a comment can't carry a non-string detail (which would crash the piece when expanded) or an oversized one.
        // The get() on the post is the same doc commentCountMoved reads, so it doesn't cost an extra billed read.
        function commentPieceValid(d) {
        	return !('piece' in d)
          	|| (d.piece is map
            	&& d.piece.keys().hasOnly(['pieceIndex', 'name', 'price', 'size', 'materials', 'dateAcquired', 'hasDetails'])
              && d.piece.pieceIndex is int
              && pieceDetailsValid(d.piece)
              && d.piece.name == get(postPath()).data.pieces[d.piece.pieceIndex].name
              && d.piece.hasDetails == get(postPath()).data.hasDetails);
        }

      	allow read: if isSignedIn();

        // Create: as yourself, with the post's commentCount moving up by 1 in the same batch (postService.addComment).
        allow create: if isSignedIn()
        							&& request.resource.data.keys().hasOnly(['id', 'uid', 'username', 'comment', 'createdAt', 'likeCount', 'piece'])
                      && request.resource.data.id == commentId
                      && request.resource.data.uid == request.auth.uid
                      && isUsername(request.resource.data.username)
                      && request.resource.data.comment is string
                      && request.resource.data.comment.size() > 0
                      && request.resource.data.comment.size() <= 500
                      && isNow(request.resource.data.createdAt)
                      && request.resource.data.likeCount == 0
                      && commentCountMoved(1)
                      && commentPieceValid(request.resource.data);

        // The two update cases below are additive, same as the post's update cases: an update goes through if EITHER passes, so each one pins down its own field set.
        // Update case #1: the like counter, which behaves exactly like the post like counter above: it moves by 1 and only when the same batched write also creates/deletes the caller's own like doc.
        // Because the like doc id is the liker's uid, this one CAN be bound to a fixed path (unlike the comment counter on the post doc), so the count can't drift.
      	allow update: if isSignedIn()
        							&& request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount'])
                      && (
                      	(request.resource.data.likeCount == resource.data.likeCount + 1
                        	&& !exists(myCommentLikePath())
                          && existsAfter(myCommentLikePath()))
                        ||
                        (request.resource.data.likeCount == resource.data.likeCount - 1
                        	&& exists(myCommentLikePath())
                          && !existsAfter(myCommentLikePath()))
                      );

        // Update case #2: the author editing their own comment's text. Only comment and editedAt can move, so everything else (id, uid, username, createdAt, likeCount) stays frozen and an edit can't be used to reassign the comment or nudge its like count.
        // The same size limits as create apply, and editedAt has to be the server's time, so an edited comment is always marked as such (and when).
        allow update: if isSignedIn()
        							&& request.auth.uid == resource.data.uid
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['comment', 'editedAt'])
                      && request.resource.data.comment is string
                      && request.resource.data.comment.size() > 0
                      && request.resource.data.comment.size() <= 500
                      && isNow(request.resource.data.editedAt);

        // Delete: by the author or the post's owner (moderation), with the post's commentCount moving down by 1 in the same batch (postService.deleteComment).
        // Deleting a comment orphans its likes subcollection, same caveat as deleting a post.
        allow delete: if isSignedIn()
        							&& (request.auth.uid == resource.data.uid
                      		|| request.auth.uid == get(postPath()).data.uid)
                      && commentCountMoved(-1);

        // Comment likes, identical in shape to the post likes block above (doc id = the liker's uid, which is what enforces one like per user and toggling your OWN like only).
        match /likes/{userId} {
        	// Same pairing as the post likes block: the comment's likeCount has to move by delta in the same batch.
        	function commentLikeCountMoved(delta) {
          	let commentPath = /databases/$(database)/documents/posts/$(postId)/comments/$(commentId);
          	return getAfter(commentPath).data.likeCount == get(commentPath).data.likeCount + delta;
          }

        	allow read: if isSignedIn();
          allow create: if isSignedIn()
          							&& request.auth.uid == userId
                        && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
                        && request.resource.data.uid == userId
                        && isNow(request.resource.data.createdAt)
                        && commentLikeCountMoved(1);
          allow update: if false;
          allow delete: if isSignedIn()
          							&& request.auth.uid == userId
                        && commentLikeCountMoved(-1);
        }
      }
    }

    // One doc per one-to-one chat. The doc id is the two participants' UIDs sorted and joined with an underscore (uidA_uidB), so the same two people can never end up with two chats, and the id alone says who's in it.
    // Anyone signed in can start a chat with any other user for now (D1 in planning/brainstorming.txt). Blocking/privacy controls would add a gate to the create rule later.
    match /chats/{chatId} {
    	// This function checks whether the caller is one of the two people in this chat, read straight off the doc id. The create rule below forces the id to match participantIds, so the id can be trusted.
      // Reading it off the id (instead of the doc) is also what lets the get rule work on a chat that doesn't exist yet, which the app checks before the first message is sent.
    	function isParticipant() {
      	return request.auth.uid in chatId.split('_');
      }

      // This function handles field-level validation for the latest-message preview of a NEW message, shared by create (the first message) and update case #1 (every message after).
      // messageId is which message the preview is a copy of, which is what lets the edit/unsend rules below keep the two in sync.
      function previewValid(p) {
      	return p.keys().hasOnly(['messageId', 'senderId', 'text', 'createdAt'])
        	&& p.messageId is string
        	&& p.senderId == request.auth.uid
          && p.text is string
          && p.text.size() > 0
          && p.text.size() <= 1000
          && isNow(p.createdAt);
      }

      // This function fetches the path of the message the current preview is a copy of (used by update case #3).
      function previewMessagePath() {
      	return /databases/$(database)/documents/chats/$(chatId)/messages/$(resource.data.lastMessage.messageId);
      }

      // Get: only the two participants. List: the chat list query (participantIds array-contains my UID) only ever asks for chats you're in, which is what lets the rules allow it.
      allow get: if isSignedIn() && isParticipant();
      allow list: if isSignedIn() && request.auth.uid in resource.data.participantIds;

      // Create: happens in the same batch as the first message (chatService.sendMessage). participantIds has to be exactly two different, sorted UIDs, one of them the caller's, and both real users.
      // The id has to be those two UIDs joined. Sorting with < also rules out starting a chat with yourself, since a UID isn't less than itself.
      // lastRead can only hold the creator's own key (set to the server's time), so nobody can start a chat with the other person's read state already set (which would hide the unread dot and show "Seen" early).
      allow create: if isSignedIn()
      							&& request.resource.data.keys().hasOnly(['participantIds', 'createdAt', 'updatedAt', 'lastMessage', 'lastRead'])
                    && request.resource.data.participantIds is list
                    && request.resource.data.participantIds.size() == 2
                    && request.resource.data.participantIds[0] < request.resource.data.participantIds[1]
                    && request.auth.uid in request.resource.data.participantIds
                    && chatId == request.resource.data.participantIds[0] + '_' + request.resource.data.participantIds[1]
                    && exists(/databases/$(database)/documents/users/$(request.resource.data.participantIds[0]))
                    && exists(/databases/$(database)/documents/users/$(request.resource.data.participantIds[1]))
                    && isNow(request.resource.data.createdAt)
                    && isNow(request.resource.data.updatedAt)
                    && previewValid(request.resource.data.lastMessage)
                    && request.resource.data.lastRead is map
                    && request.resource.data.lastRead.keys().hasOnly([request.auth.uid])
                    && request.resource.data.lastRead.get(request.auth.uid, request.time) == request.time;

      // The three update cases below are additive, same as the post's update cases: an update goes through if ANY ONE passes, so each one pins down its own field set.
      // Update case #1: a participant sending a message moves the latest-message preview and updatedAt, which has to match the preview's timestamp so the chat list stays in order.
      // The preview can't be bound to the message doc from this side (the message id is client-generated, same caveat as the post's commentCount), but the message create rule below closes the other direction: a message can't be sent without the preview moving with it.
      allow update: if isSignedIn()
      							&& isParticipant()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage', 'updatedAt'])
                    && previewValid(request.resource.data.lastMessage)
                    && request.resource.data.updatedAt == request.resource.data.lastMessage.createdAt;

      // Update case #2: a participant marking the chat as read (chatService.markRead). Only lastRead can move, and inside it only the caller's own key, so nobody can mark a chat read (or unread) on someone else's behalf.
      allow update: if isSignedIn()
      							&& isParticipant()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastRead'])
                    && request.resource.data.lastRead.diff(resource.data.lastRead).affectedKeys().hasOnly([request.auth.uid])
                    && isNow(request.resource.data.lastRead[request.auth.uid]);

      // Update case #3: the sender of the latest message keeping the preview in sync when they edit or unsend that message (chatService.editMessage / unsendMessage). Only lastMessage can move, it has to stay a preview of the same message, and updatedAt stays put so editing doesn't bump the chat to the top of the list.
      // Edit: the preview's text and editedAt have to match the message doc as it will be AFTER the batch. Unsend: the message doc has to be gone after the batch, and the preview is emptied and marked unsent so the list never shows unsent text.
      // The unsend check comes first, since getAfter() on a deleted message has nothing to read.
      allow update: if isSignedIn()
      							&& isParticipant()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage'])
                    && resource.data.lastMessage.senderId == request.auth.uid
                    && request.resource.data.lastMessage.messageId == resource.data.lastMessage.messageId
                    && request.resource.data.lastMessage.senderId == resource.data.lastMessage.senderId
                    && request.resource.data.lastMessage.createdAt == resource.data.lastMessage.createdAt
                    && (
                    	(request.resource.data.lastMessage.keys().hasOnly(['messageId', 'senderId', 'text', 'createdAt', 'unsent'])
                      	&& request.resource.data.lastMessage.text == ''
                        && request.resource.data.lastMessage.unsent == true
                        && !existsAfter(previewMessagePath()))
                      ||
                      (request.resource.data.lastMessage.keys().hasOnly(['messageId', 'senderId', 'text', 'createdAt', 'editedAt'])
                      	&& existsAfter(previewMessagePath())
                        && request.resource.data.lastMessage.text == getAfter(previewMessagePath()).data.text
                        && request.resource.data.lastMessage.editedAt == getAfter(previewMessagePath()).data.editedAt)
                    );

      // Delete: off for now. Deleting a chat would orphan its messages subcollection (same as posts), and "delete for me" vs "delete for both" still needs deciding.
      allow delete: if false;

      // MUST stay nested inside the chats block (same reason as likes/comments inside posts), which is also what puts chatId in scope.
      // One doc per message. Messages can be sent, edited by their sender for 15 minutes, and unsent (deleted) by their sender at any time.
      match /messages/{messageId} {
      	// This function fetches the path of the parent chat doc, which every write below checks with getAfter() to keep the chat's preview in sync.
      	function chatPath() {
        	return /databases/$(database)/documents/chats/$(chatId);
        }

        // This function checks whether this message is the one the chat's preview is a copy of, AFTER the batch. get() with a fallback covers a preview that has no messageId.
        function isPreviewedAfter() {
        	return getAfter(chatPath()).data.lastMessage.get('messageId', '') == messageId;
        }

        // This function handles validation for an optional reply. A reply only stores which message it's replying to and who sent that one, never a copy of its text, so editing or unsending the original can't leave a stale or unsent quote behind.
        // get() on the original is what proves it exists in this same chat (a missing doc fails the request), and its senderId has to match.
        function replyValid(d) {
        	return !('replyTo' in d)
          	|| (d.replyTo is map
            	&& d.replyTo.keys().hasOnly(['messageId', 'senderId'])
              && d.replyTo.messageId is string
              && d.replyTo.senderId == get(/databases/$(database)/documents/chats/$(chatId)/messages/$(d.replyTo.messageId)).data.senderId);
        }

      	// Same participant check as the chat itself. Since it only needs the path, the messages query works without a billed get() on the chat doc for every read.
      	allow read: if isSignedIn() && request.auth.uid in chatId.split('_');

        // Create: as yourself only, with a known field set, 1-1000 characters of text, and an optional valid reply.
        // createdAt has to be the server's time (isNow), so a fake timestamp can't stretch the edit window below or slip the message in among older ones.
        // getAfter() reads the chat doc as it will be AFTER the batch commits, which ties the message to its preview: the chat has to exist (or be created in the same batch) with this exact message as its lastMessage.
        allow create: if isSignedIn()
        							&& request.auth.uid in chatId.split('_')
                      && request.resource.data.keys().hasOnly(['senderId', 'text', 'createdAt', 'replyTo'])
                      && request.resource.data.senderId == request.auth.uid
                      && request.resource.data.text is string
                      && request.resource.data.text.size() > 0
                      && request.resource.data.text.size() <= 1000
                      && isNow(request.resource.data.createdAt)
                      && replyValid(request.resource.data)
                      && isPreviewedAfter()
                      && getAfter(chatPath()).data.lastMessage.senderId == request.resource.data.senderId
                      && getAfter(chatPath()).data.lastMessage.text == request.resource.data.text
                      && getAfter(chatPath()).data.lastMessage.createdAt == request.resource.data.createdAt;

        // Update (edit): the sender only, within 15 minutes of sending, and only text + editedAt can move (so an edit can't change who sent it, when, or what it replies to).
        // If this is the chat's latest message, the preview has to carry the same new text and editedAt after the batch (update case #3 on the chat), so the chat list never shows the old text.
        allow update: if isSignedIn()
        							&& request.auth.uid == resource.data.senderId
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'editedAt'])
                      && request.resource.data.text is string
                      && request.resource.data.text.size() > 0
                      && request.resource.data.text.size() <= 1000
                      && isNow(request.resource.data.editedAt)
                      && request.time < resource.data.createdAt + duration.value(15, 'm')
                      && (!isPreviewedAfter()
                      		|| (getAfter(chatPath()).data.lastMessage.text == request.resource.data.text
                          		&& getAfter(chatPath()).data.lastMessage.get('editedAt', '') == request.resource.data.editedAt));

        // Delete (unsend): the sender only, at any time. If this is the chat's latest message, the preview has to be marked unsent in the same batch (update case #3 on the chat), so its text disappears from the chat list too.
        // Replies to an unsent message are left as they are: they only point at it by id, so they just show it as unsent.
        allow delete: if isSignedIn()
        							&& request.auth.uid == resource.data.senderId
                      && (!isPreviewedAfter() || getAfter(chatPath()).data.lastMessage.get('unsent', false) == true);
      }
    }
  }
}
