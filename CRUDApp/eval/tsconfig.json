{
  // TypeScript settings for the rules tests only. The app's tsconfig.app.json only covers src/, so without this file the editor checks eval/ with TypeScript's old defaults (CommonJS),
  // which flags import.meta in helpers.ts even though Vitest runs the tests fine. These match how Vitest actually runs them: modern ES modules on Node.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["tests", "vitest.config.ts"]
}
